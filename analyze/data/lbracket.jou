reset
create brick x 1 y 1 z 0.01
webcut volume all with plane xplane offset -0.1
webcut volume all with plane yplane offset -0.1
delete volume 3
unite volume all
webcut volume all with plane yplane offset -0.16
imprint all
merge all
volume all scheme tetmesh
volume all size 0.01
sideset 1 curve 76
sideset 1 name "load"
nodeset 1 curve 26
nodeset 1 name "fix"
block 1 surface 44 42
block 1 element type tri
block 1 name "block_1"
mesh surface 44 42
export mesh "lbracket.exo" overwrite

delete mesh volume all propagate
volume all size 0.015
mesh volume all

delete block all
delete sideset all
delete nodeset all 

sideset 1 surface 45
sideset 1 name "load"
nodeset 1 surface 13
nodeset 1 name "fix"

block 1 volume all
block 1 name "block_1"

export mesh "lbracket3d.exo" overwrite