<ParameterList name="Problem">
  <Parameter name="Physics" type="string" value="Plato Driver" />
  <Parameter name="Spatial Dimension" type="int" value="3" />
  <Parameter name="Input Mesh" type="string" value="cut.exo" />
  <ParameterList name="Plato Problem">
    <Parameter name="Physics" type="string" value="Mechanical" />
    <Parameter name="PDE Constraint" type="string" value="Elliptic" />
    <Parameter name="Self-Adjoint" type="bool" value="false" />
    <ParameterList name="Criteria">
      <ParameterList name="My Volume">
        <Parameter name='Linear' type='bool' value='true'/>
        <Parameter name="Type" type="string" value="Mass Properties" />
        <Parameter name="Properties" type="Array(string)" value="{Mass}" />
        <Parameter name="Gold Values" type="Array(double)" value="{1.6e-3}" />
        <Parameter name="Weights" type="Array(double)" value="{1e6}" />
        <ParameterList name="Penalty Function">
          <Parameter name="Type" type="string" value="SIMP"/>
          <Parameter name="Exponent" type="double" value="1.0"/>
          <Parameter name="Minimum Value" type="double" value="0.0"/>
        </ParameterList>
      </ParameterList>
    </ParameterList>
    <ParameterList name="Elliptic">
      <ParameterList name="Penalty Function">
        <Parameter name="Type" type="string" value="SIMP" />
        <Parameter name="Exponent" type="double" value="3.0" />
        <Parameter name="Minimum Value" type="double" value="1e-3" />
      </ParameterList>
    </ParameterList>
    <ParameterList name="Spatial Model">
    <Parameter name='Ignore Missing Element Blocks' type='bool' value='true'/>
      <ParameterList name="Domains">
        <ParameterList name="Block 1">
          <Parameter name="Element Block" type="string" value="block_1" />
          <Parameter name="Material Model" type="string" value="dummy_material" />
        </ParameterList>
        <ParameterList name="Block 1 Void">
          <Parameter name="Element Block" type="string" value="block_1_void" />
          <Parameter name="Material Model" type="string" value="void_material" />
        </ParameterList>
      </ParameterList>
    </ParameterList>
    <ParameterList name="Material Models">
      <ParameterList name="dummy_material">
        <ParameterList name="Isotropic Linear Elastic">
          <Parameter name="Poissons Ratio" type="double" value=".3" />
          <Parameter name="Youngs Modulus" type="double" value="1e8" />
          <Parameter name="Mass Density" type="double" value="1" />
        </ParameterList>
        <Parameter name="Density" type="double" value="1" />
      </ParameterList>
      <ParameterList name="void_material">
        <ParameterList name="Isotropic Linear Elastic">
          <Parameter name="Poissons Ratio" type="double" value=".3" />
          <Parameter name="Youngs Modulus" type="double" value="70e9" />
          <Parameter name="Mass Density" type="double" value="0" />
        </ParameterList>
        <Parameter name="Density" type="double" value="0" />
      </ParameterList>
    </ParameterList>
    <ParameterList  name="Natural Boundary Conditions">
      <ParameterList  name="Traction Vector Boundary Condition">
        <Parameter  name="Type"     type="string"        value="Uniform"/>
        <Parameter  name="Values"   type="Array(double)" value="{0.0, -1e5, 0}"/>
        <Parameter  name="Sides"    type="string"        value="load"/>
      </ParameterList>
    </ParameterList>

    <ParameterList  name="Essential Boundary Conditions">

      <ParameterList  name="X Fixed Displacement Boundary Condition 1">
        <Parameter  name="Type"     type="string" value="Zero Value"/>
        <Parameter  name="Index"    type="int"    value="0"/>
        <Parameter  name="Sides"    type="string" value="fix"/>
      </ParameterList>
      <ParameterList  name="Y Fixed Displacement Boundary Condition 1">
        <Parameter  name="Type"     type="string" value="Zero Value"/>
        <Parameter  name="Index"    type="int"    value="1"/>
        <Parameter  name="Sides"    type="string" value="fix"/>
      </ParameterList>
      <ParameterList  name="Z Fixed Displacement Boundary Condition 1">
        <Parameter  name="Type"     type="string" value="Zero Value"/>
        <Parameter  name="Index"    type="int"    value="2"/>
        <Parameter  name="Sides"    type="string" value="fix"/>
      </ParameterList>

    </ParameterList>
  </ParameterList>
</ParameterList>
