<ParameterList name="Problem">
  <Parameter name="Physics" type="string" value="Plato Driver" />
  <Parameter name="Spatial Dimension" type="int" value="3" />
  <Parameter name="Input Mesh" type="string" value="lbracket3d.exo" />
  <ParameterList name="Plato Problem">
    <Parameter name="Physics" type="string" value="Mechanical" />
    <Parameter name="PDE Constraint" type="string" value="Elliptic" />
    <Parameter name="Self-Adjoint" type="bool" value="false" />
    <ParameterList name="Criteria">
      <ParameterList name="P Norm">
        <Parameter name="Type" type="string" value="Scalar Function"/> 
        <Parameter name="Scalar Function Type" type="string" value="Stress P-Norm"/>
        <Parameter name="Exponent" type="double" value="1.3" />
        <ParameterList name="Normalize">
          <Parameter name="Type" type="string" value="Voigt Tensor L2"/>
        </ParameterList>
        <ParameterList name="Penalty Function">
          <Parameter name="Type" type="string" value="SIMP"/>
          <Parameter name="Exponent" type="double" value="1."/>
          <Parameter name="Minimum Value" type="double" value="1e-3"/>
        </ParameterList>
      </ParameterList>
    </ParameterList>
    <ParameterList name="Elliptic">
      <ParameterList name="Penalty Function">
        <Parameter name="Type" type="string" value="SIMP" />
        <Parameter name="Exponent" type="double" value="1.0" />
        <Parameter name="Minimum Value" type="double" value="1e-3" />
      </ParameterList>
    </ParameterList>
    <ParameterList name="Spatial Model">
    <Parameter name='Ignore Missing Element Blocks' type='bool' value='true'/>
      <ParameterList name="Domains">
        <ParameterList name="Block 1">
          <Parameter name="Element Block" type="string" value="block_1" />
          <Parameter name="Material Model" type="string" value="steel" />
        </ParameterList>
        <ParameterList name="Block 1 Void">
          <Parameter name="Element Block" type="string" value="block_1_void" />
          <Parameter name="Material Model" type="string" value="void_material" />
        </ParameterList>
      </ParameterList>
    </ParameterList>
    <ParameterList name="Material Models">
      <ParameterList name="steel">
        <ParameterList name="Isotropic Linear Elastic">
          <Parameter name="Poissons Ratio" type="double" value=".3" />
          <Parameter name="Youngs Modulus" type="double" value="200e9" />
          <Parameter name="Mass Density" type="double" value="7800" />
        </ParameterList>
        <Parameter name="Density" type="double" value="7800" />
      </ParameterList>
      <ParameterList name="void_material">
        <ParameterList name="Isotropic Linear Elastic">
          <Parameter name="Poissons Ratio" type="double" value=".3" />
          <Parameter name="Youngs Modulus" type="double" value="200e6" />
          <Parameter name="Mass Density" type="double" value="7800" />
        </ParameterList>
        <Parameter name="Density" type="double" value="7800" />
      </ParameterList>
    </ParameterList>

    <ParameterList name="Natural Boundary Conditions">
      <ParameterList name="Traction Vector">
        <Parameter name="Type" type="string" value="Uniform" />
        <Parameter name="Values" type="Array(string)" value="{0,-5e3,0}" />
        <Parameter name="Sides" type="string" value="load" />
      </ParameterList>
    </ParameterList>
    
    <ParameterList name="Essential Boundary Conditions">
      <ParameterList name="Displacement Boundary Condition X">
        <Parameter name="Type" type="string" value="Fixed Value" />
        <Parameter name="Index" type="int" value="0" />
        <Parameter name="Sides" type="string" value="fix" />
        <Parameter name="Value" type="double" value="0" />
      </ParameterList>
      <ParameterList name="Displacement Boundary Condition Y">
        <Parameter name="Type" type="string" value="Fixed Value" />
        <Parameter name="Index" type="int" value="1" />
        <Parameter name="Sides" type="string" value="fix" />
        <Parameter name="Value" type="double" value="0" />
      </ParameterList>
      <ParameterList name="Displacement Boundary Condition Z">
        <Parameter name="Type" type="string" value="Fixed Value" />
        <Parameter name="Index" type="int" value="2" />
        <Parameter name="Sides" type="string" value="fix" />
        <Parameter name="Value" type="double" value="0" />
      </ParameterList>
    </ParameterList>
  
  </ParameterList>
</ParameterList>
